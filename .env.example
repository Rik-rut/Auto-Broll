# ============================================================
# LLM (transcript analysis, prompt writing, download selection)
# ============================================================

# anthropic | openai | ollama | openai_compatible
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
# only needed for ollama / openai_compatible endpoints
LLM_BASE_URL=
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120

# ============================================================
# Transcription (faster-whisper)
# ============================================================

# tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=medium
# cuda | cpu
WHISPER_DEVICE=cuda
# float16 | int8 | int8_float16 | float32
WHISPER_COMPUTE_TYPE=float16
# blank = auto-detect
WHISPER_LANGUAGE=

# ============================================================
# Pipeline toggles — both may be true at the same time
# ============================================================

# generate images locally with Z-Image Turbo
GENERATE_BROLL=true
# search + download images via SearXNG
DOWNLOAD_BROLL=true

# ============================================================
# Z-Image Turbo (local generation — mmgp int8 pipeline)
# ============================================================

# Path to local model directory containing quantized transformer + text encoder + VAE
ZIMAGE_MODEL_DIR=./z-image model
# cuda | cpu
ZIMAGE_DEVICE=cuda
ZIMAGE_IMAGES_PER_PROMPT=3
# 4 steps is optimal for Z-Image Turbo (distilled, no CFG)
ZIMAGE_NUM_INFERENCE_STEPS=4
# must stay 0.0 — Z-Image Turbo is distilled without CFG
ZIMAGE_GUIDANCE_SCALE=0.0
# blank = random seed per image
ZIMAGE_SEED=

# Triton int8 kernel acceleration (falls back gracefully if unavailable)
ZIMAGE_QUANTO_INT8_KERNEL=true
# mmgp VRAM allocation profile (1=HighRAM_HighVRAM, 2=HighRAM_LowVRAM, 3=LowRAM_HighVRAM, 4=LowRAM_LowVRAM, 5=VerylowRAM_LowVRAM)
ZIMAGE_MMGP_PROFILE=5
# max GPU memory reservation percentage (0.0-1.0)
ZIMAGE_PERC_RESERVED_MEM_MAX=0.9
# VRAM safety margin
ZIMAGE_VRAM_SAFETY_COEFFICIENT=0.1
# auto | sdpa | flash | sage
ZIMAGE_ATTENTION_BACKEND=auto
# path to the b-roll variation list (JSON data file)
VARIATIONS_FILE=./config/image_variations.json

# ============================================================
# Image output — governs both generation size and download filtering
# ============================================================

# label; keep in sync with the dimensions below
ASPECT_RATIO=9:16
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920
STYLE_PROMPT="cinematic photo, natural lighting, shallow depth of field, photorealistic, 35mm film grain"
NEGATIVE_PROMPT=

# ============================================================
# SearXNG (broll image search + download)
# ============================================================

SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_SECONDS=15
DOWNLOAD_IMAGES_PER_BROLL=3
# results pulled from SearXNG before the LLM narrows them down
DOWNLOAD_CANDIDATE_POOL_SIZE=15
DOWNLOAD_MIN_WIDTH=640
DOWNLOAD_MIN_HEIGHT=640
DOWNLOAD_TIMEOUT_SECONDS=20

# ============================================================
# Paths
# ============================================================

INPUT_DIR=./input
OUTPUT_DIR=./output

# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO
